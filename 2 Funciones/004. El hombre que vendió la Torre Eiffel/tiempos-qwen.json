": 26.66, "f": 26.88}, {"p": "de", "a": 26.88, "f": 27.08}, {"p": "ellos,", "a": 27.08, "f": 27.34}, {"p": "André", "a": 27.62, "f": 27.86}, {"p": "Poisson,", "a": 27.86, "f": 28.22}, {"p": "se", "a": 28.58, "f": 28.68}, {"p": "lo", "a": 28.68, "f": 28.86}, {"p": "creyó", "a": 28.86, "f": 29.26}, {"p": "todo.", "a": 29.26, "f": 29.62}, {"p": "Pagó", "a": 29.62, "f": 30.3}, {"p": "por", "a": 30.3, "f": 30.5}, {"p": "la", "a": 30.5, "f": 30.64}, {"p": "torre...", "a": 30.64, "f": 31.02}, {"p": "y", "a": 31.02, "f": 31.36}, {"p": "encima", "a": 31.36, "f": 31.72}, {"p": "le", "a": 31.72, "f": 31.86}, {"p": "dio", "a": 31.86, "f": 32.06}, {"p": "un", "a": 32.06, "f": 32.18}, {"p": "soborno", "a": 32.18, "f": 32.8}, {"p": "para", "a": 32.8, "f": 33.06}, {"p": "quedársela.", "a": 33.06, "f": 33.96}]}, {"quien": "NARRADOR", "emo": "asombro", "texto": "Lustig huyó a Austria con la plata. Y Poisson nunca lo denunció... le dio demasiada *vergüenza*.", "ini": 34.128, "fin": 40.583, "palabras": [{"p": "Lustig", "a": 34.14, "f": 34.74}, {"p": "huyó", "a": 34.74, "f": 35.08}, {"p": "a", "a": 35.08, "f": 35.26}, {"p": "Austria", "a": 35.26, "f": 35.56}, {"p": "con", "a": 35.56, "f": 35.84}, {"p": "la", "a": 35.84, "f": 35.98}, {"p": "plata.", "a": 35.98, "f": 36.28}, {"p": "Y", "a": 36.28, "f": 36.74}, {"p": "Poisson", "a": 36.74, "f": 37.04}, {"p": "nunca", "a": 37.04, "f": 37.42}, {"p": "lo", "a": 37.42, "f": 37.72}, {"p": "denunció...", "a": 37.72, "f": 38.32}, {"p": "le", "a": 38.98, "f": 39.18}, {"p": "dio", "a": 39.18, "f": 39.38}, {"p": "demasiada", "a": 39.38, "f": 39.9}, {"p": "vergüenza.", "a": 39.9, "f": 40.4}]}, {"quien": "NARRADOR", "emo": "tension", "texto": "Así que Lustig volvió a París... e intentó venderla *otra vez*. Esta vez, alguien avisó a la policía.", "ini": 40.703, "fin": 46.422, "palabras": [{"p": "Así", "a": 40.68, "f": 40.9}, {"p": "que", "a": 40.9, "f": 41.06}, {"p": "Lustig", "a": 41.06, "f": 41.42}, {"p": "volvió", "a": 41.42, "f": 41.74}, {"p": "a",