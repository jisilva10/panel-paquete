": "culpan", "a": 27.26, "f": 27.58}, {"p": "de", "a": 27.58, "f": 27.72}, {"p": "la", "a": 27.72, "f": 27.8}, {"p": "muerte", "a": 27.8, "f": 28.06}, {"p": "de", "a": 28.06, "f": 28.24}, {"p": "unos", "a": 28.24, "f": 28.36}, {"p": "treinta", "a": 28.36, "f": 28.68}, {"p": "campesinos.", "a": 28.68, "f": 29.38}]}, {"quien": "NARRADOR", "emo": "confidencial", "texto": "En mil novecientos setenta y cuatro llegó un joven japonés que buscaba tres cosas: al teniente Onoda, un oso panda... y al Abominable Hombre de las Nieves.", "ini": 29.752, "fin": 39.27, "palabras": [{"p": "En", "a": 29.752, "f": 30.105}, {"p": "mil", "a": 30.105, "f": 30.457}, {"p": "novecientos", "a": 30.457, "f": 30.81}, {"p": "setenta", "a": 30.81, "f": 31.162}, {"p": "y", "a": 31.162, "f": 31.515}, {"p": "cuatro", "a": 31.515, "f": 31.867}, {"p": "llegó", "a": 31.867, "f": 32.22}, {"p": "un", "a": 32.22, "f": 32.572}, {"p": "joven", "a": 32.572, "f": 32.925}, {"p": "japonés", "a": 32.925, "f": 33.277}, {"p": "que", "a": 33.277, "f": 33.63}, {"p": "buscaba", "a": 33.63, "f": 33.982}, {"p": "tres", "a": 33.982, "f": 34.335}, {"p": "cosas:", "a": 34.335, "f": 34.687}, {"p": "al", "a": 34.687, "f": 35.04}, {"p": "teniente", "a": 35.04, "f": 35.392}, {"p": "Onoda,", "a": 35.392, "f": 35.745}, {"p": "un", "a": 35.745, "f": 36.097}, {"p": "oso", "a": 36.097, "f": 36.45}, {"p": "panda...", "a": 36.45, "f": 36.802}, {"p": "y", "a": 36.802, "f": 37.155}, {"p": "al", "a": 37.155, "f": 37.507}, {"p": "Abominable", "a": 37.507, "f": 37.86}, {"p": "Hombre", "a": 37.86, "f": 38.212}, {"p": "de", "a": 38.212, "f": 38.565}, {"p": "las", "a": 38.565, "f": 38.917}, {"p": "Nieves.", "a": 38.917, "f": 39.27}]}, {"quien": "NARRADOR", "emo": "asombro", "texto": "Lo encontró en cuatro días. Pero Onoda no se rindió. Solo obedecía a su comandante.", "ini": 39.39, "fin": 45.909, "palabras": [{"p": "Lo", "a": 39.34, "f": 39.6}, {"p": "encontró", "a": 39.6, "f": 40.26}, {"p": "en", "a": 40.26, "f": 40.76}, {"p": "cuatro", "a